
/* Winner Section */
.winner-section {
  margin: 20px 0;
  padding: 15px;
  background: linear-gradient(135deg, #fff3cd 0%, #ffecb3 100%);
  border: 2px solid #ffc107;
  border-radius: 8px;
  text-align: center;
}

.winner-section h4 {
  color: #856404;
  margin-bottom: 10px;
  font-size: 1.1rem;
}

.winner-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.winner-title {
  font-weight: bold;
  font-size: 1.2rem;
  color: #333;
}

.winner-stats {
  display: flex;
  align-items: center;
  gap: 10px;
}

.winner-stats .score {
  font-weight: bold;
  color: #666;
}
